# Assign static name "sta0" to wireless devices with the driver "unisoc_wifi"
SUBSYSTEM=="net", ACTION!="remove", ENV{DEVTYPE}=="wlan", DRIVERS=="unisoc_wifi", NAME="sta0"

# Randomize MAC address for all cabled Ethernet devices, excluding Bluetooth and WLAN
SUBSYSTEM=="net", ACTION!="remove", ENV{DEVTYPE}!="wlan", ENV{DEVTYPE}!="bluetooth", TEST!="/sys/class/net/$name/tun_flags", TEST!="/sys/class/net/$name/bridge", RUN+="/usr/local/sbin/changemacmon randomize-mac $name"

# Keep USB (especially USB3) interfaces from getting designed as "wlan0"
SUBSYSTEM=="net", ACTION!="remove", SUBSYSTEMS=="usb", NAME="wlan1"

# Handle wireless interfaces (wlan)
SUBSYSTEM=="net", ACTION!="remove", ENV{DEVTYPE}=="wlan", NAME!="sta0", ATTR{type}!="803" ENV{NM_UNMANAGED}="1", RUN+="/usr/local/sbin/changemacmon handle-interface $name"
