SUBSYSTEM=="net", ACTION!="move|remove", ENV{DEVTYPE}=="wlan", NAME!="mon*", ATTR{type}=="1", ENV{NM_UNMANAGED}="1", RUN+="/usr/local/sbin/changemacmon handle-interface $name"
SUBSYSTEM=="net", ACTION!="remove", ENV{DEVTYPE}!="wlan", ENV{DEVTYPE}!="bluetooth", ATTR{type}=="1", TEST!="/sys/class/net/$name/tun_flags", TEST!="/sys/class/net/$name/bridge", RUN+="/usr/local/sbin/changemacmon randomize-mac $name"
