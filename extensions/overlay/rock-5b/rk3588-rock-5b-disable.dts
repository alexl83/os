                __overlay__ {
                status = "disabled";
                        };
                };

        fragment@3 {
                target-path = "/serial@feb50000";
                __overlay__ {
                status = "disabled";
                        };
                };

        fragment@4 {
                target-path = "/serial@febc0000";
                __overlay__ {
                status = "disabled";
                        };
                };

        fragment@5 {
                target-path = "/display-subsystem";
                __overlay__ {
                status = "disabled";
                        };
                };

        fragment@6 {
