/dts-v1/;
/plugin/;

/ {
        compatible = "radxa,rock-5b\0rockchip,rk3588";
        fragment@0 {
                target-path = "/gpu@fb000000";
                __overlay__ {
                status = "disabled";
                        };
                };

        fragment@1 {
                target-path = "/vop@fdd90000";
                __overlay__ {
                status = "disabled";
